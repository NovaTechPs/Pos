APP_NAME=WaslaPOS
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://pos.example.com

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=waslapos
DB_USERNAME=waslapos
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

BRANCH_SYNC_MODE=central
BRANCH_SYNC_SERVER_URL=
BRANCH_SYNC_TOKEN=
OPEN_EXCHANGE_RATES_APP_ID=

BACKUP_MYSQL_BINARY=mysqldump
BACKUP_PGSQL_BINARY=pg_dump
